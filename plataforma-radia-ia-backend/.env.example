# Puerto del servidor (Railway lo inyecta automaticamente; en local usa el valor que definas aqui)
PORT=tu_puerto

# Conexion a MySQL
DB_HOST=tu_host_de_mysql
DB_PORT=tu_puerto_de_mysql
DB_USER=tu_usuario_de_mysql
DB_PASSWORD=tu_contrasena_de_mysql
DB_NAME=tu_nombre_de_base_de_datos

# Clave de firma de los tokens JWT (cadena larga y aleatoria, distinta en cada entorno)
JWT_SECRET=tu_clave_secreta_para_jwt

# URL del frontend (usada para armar enlaces en los correos de bienvenida/registro)
FRONTEND_URL=tu_url_del_frontend

# API key de Gemini (opcional: solo necesaria para la generacion de lecciones/contenido con IA)
GEMINI_API_KEY=tu_api_key_de_gemini
# Modelo de Gemini a usar (opcional, por defecto: gemini-flash-latest)
GEMINI_MODEL=tu_modelo_de_gemini

# Ruta al modelo de IA (TensorFlow.js) usado para la inferencia de radiografias
MODEL_PATH=tu_ruta_al_model_json
